# Azure ARM Security Analyzer - Environment Configuration Example

# Flask Server Configuration
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
MAX_CONTENT_LENGTH=10485760

# Phase 2: Dual AI Provider Configuration (Google Gemini & Ollama)
AI_ENABLED=true
AI_PROVIDER=gemini

# Google Gemini API Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Local Ollama Settings (Optional - used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Common AI Options
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_MAX_CONTEXT_SIZE=32000

